{
  "name": "minecraft-server-manager",
  "version": "1.0.0",
  "description": "Desktop application for managing local Minecraft servers",
  "main": "./out/main/index.js",
  "author": "wllamasr",
  "license": "MIT",
  "homepage": "https://github.com/wllamasr/minecraft-server-mgr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wllamasr/minecraft-server-mgr.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-vite build && electron-builder --win --config",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@mantine/charts": "^9.6.1",
    "@mantine/core": "^9.6.1",
    "@mantine/form": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/modals": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.64.0",
    "@tanstack/react-router": "^1.95.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.3.0",
    "electron-updater": "^6.3.0",
    "i18next": "^26.4.2",
    "minecraft-server-util": "^5.4.4",
    "pidusage": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "uuid": "^14.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/router-plugin": "^1.95.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.0",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
